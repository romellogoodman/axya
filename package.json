{
  "name": "axya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite --port=8080 --open",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "oracle:setup": "python3 -m venv .venv-oracle && .venv-oracle/bin/pip install -r test/oracle/requirements.txt",
    "oracle": ".venv-oracle/bin/python -I test/oracle/generate.py",
    "format": "prettier --write \"src/**/*.{js,jsx,scss,css}\" \"server/**/*.{js,ts}\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,scss,css}\" \"server/**/*.{js,ts}\" \"test/**/*.ts\"",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules package-lock.json"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.2.1",
    "flatten-svg": "^0.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
